# Contraseña global para acceder a la app
APP_PASSWORD=cambia-esto-por-algo-seguro

# Secret para firmar cookies de sesión (genera una aleatoria)
SESSION_SECRET=otra-cadena-larga-y-aleatoria

# Background Check API (red interna Docker)
BG_API_URL=http://dentaklin_bg-api:8000
BG_API_KEY=genera-una-clave-segura-de-32-bytes-hex
BG_API_TIMEOUT=120

# Concurrencia — cuántas cédulas procesar en paralelo
MAX_WORKERS=3
